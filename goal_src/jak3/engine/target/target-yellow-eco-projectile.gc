;; ============================================================
;; yeco-projectile
;; ============================================================

(deftype yeco-projectile (projectile)
  ()
  )

(defmethod setup-collision! ((this yeco-projectile))
  "Set up collision shape"
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-projectile)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing))
    (let ((v1-6 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-6 prim-core collide-as) (collide-spec projectile))
      (set! (-> v1-6 prim-core collide-with)
            (collide-spec backgnd crate civilian enemy obstacle vehicle-sphere hit-by-others-list pusher))
      (set! (-> v1-6 prim-core action) (collide-action solid))
      (set-vector! (-> v1-6 local-sphere) 0.0 0.0 0.0 2048.0)
      (set! (-> s5-0 total-prims) (the-as uint 1))
      (set! (-> s5-0 root-prim) v1-6))
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-9 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-9 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-9 prim-core collide-with)))
    (set! (-> s5-0 max-iteration-count) (the-as uint 2))
    (set! (-> s5-0 event-self) 'touched)
    (set! (-> this root) s5-0))
  (set! (-> this root pat-ignore-mask)
        (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noproj #x1 :noendlessfall #x1 :board #x1))
  0
  (none))



(defun yeco-update-velocity ((arg0 projectile))
  (let* ((speed (vector-length (-> arg0 root transv)))
         (side (vector-x-quaternion! (new 'stack-no-clear 'vector) (-> arg0 root quat)))
         (current-dir (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> arg0 root transv) 1.0))
         (blended (new 'stack-no-clear 'vector))
         )
    (+! (-> arg0 tween) 182.0)
    (if (>= (-> arg0 tween) 65536.0)
        (set! (-> arg0 tween) (- (-> arg0 tween) 65536.0)))
    (let* ((sine-val (* 20480.0 (sin (-> arg0 tween))))
           (target (new 'stack-no-clear 'vector))
           )
      (format #t "[YECO-VEL] tween=~f sine=~f side=~f ~f ~f~%"
        (-> arg0 tween)
        sine-val
        (-> side x)
        (-> side y)
        (-> side z))
      (vector+float*! target (-> arg0 base-target-pos) side sine-val)
      (let ((to-target (vector-normalize-copy!
                         (new 'stack-no-clear 'vector)
                         (vector-! (new 'stack-no-clear 'vector) target (-> arg0 root trans))
                         1.0)))
        (format #t "[YECO-VEL] to-target=~f ~f ~f~%"
          (-> to-target x)
          (-> to-target y)
          (-> to-target z))
        (vector-lerp! blended current-dir to-target 0.1)
        (vector-normalize! blended speed)
        (vector-copy! (-> arg0 root transv) blended)
        )
      )
    )
  0
  (none))

(defmethod projectile-method-25 ((this yeco-projectile))
  "Spawn orb particles at projectile position each frame"
  (vector-copy! (-> *launch-matrix* trans) (-> this root trans))
  (sp-launch-particles-var
    *sp-particle-system-2d*
    (-> *part-id-table* 5201)
    *launch-matrix*
    (the-as sparticle-launch-state #f)
    (the-as sparticle-launch-control #f)
    1.0)
  (sp-launch-particles-var
    *sp-particle-system-2d*
    (-> *part-id-table* 5202)
    *launch-matrix*
    (the-as sparticle-launch-state #f)
    (the-as sparticle-launch-control #f)
    1.0)
  (sp-launch-particles-var
    *sp-particle-system-2d*
    (-> *part-id-table* 5203)
    *launch-matrix*
    (the-as sparticle-launch-state #f)
    (the-as sparticle-launch-control #f)
    1.0)
  (sp-launch-particles-var
    *sp-particle-system-2d*
    (-> *part-id-table* 5204)
    *launch-matrix*
    (the-as sparticle-launch-state #f)
    (the-as sparticle-launch-control #f)
    1.0)
  0
  (none))

(defmethod init-proj-settings! ((this yeco-projectile))
  "Set attack mode, speed and damage"
  (set! (-> this attack-mode) 'eco-yellow)
  (set! (-> this max-speed) 163840.0)
  (set! (-> this damage) 2.0)
  (set! (-> this vehicle-damage-factor) 1.0)
  (set! (-> this vehicle-impulse-factor) 1.0)
  (set! (-> this timeout) (seconds 3))
  (set! (-> this update-velocity) yeco-update-velocity)
  0
  (none))


(defmethod projectile-method-24 ((this yeco-projectile))
  "Run after init - target-pos is now set so we can safely read it"
  0
  (none))

(defstate impact (yeco-projectile)
  :virtual #t
  :code
  (behavior ()
    (vector-copy! (-> *launch-matrix* trans) (-> self root trans))
    (part-tracker-spawn part-tracker
      :to *entity-pool*
      :group (-> *part-group-id-table* 1562))
    (suspend)
    (go-virtual die)))

(defstate dissipate (yeco-projectile)
  :virtual #t
  :code
  (behavior ()
    (vector-copy! (-> *launch-matrix* trans) (-> self root trans))
    (part-tracker-spawn part-tracker
      :to *entity-pool*
      :group (-> *part-group-id-table* 1562))
    (suspend)
    (go-virtual die)))