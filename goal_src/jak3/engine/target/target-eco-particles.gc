(in-package goal)

;; name: target-eco-particles.gc
;; Custom particle definitions for Eco Mode visual effects
;; Part 5223 - blue eco lightning bolt
;; Part 5224 - blue eco lightning fade (next-launcher for 5223)
;; Part 5225 - yellow eco fireball hotdot
;; Part 5226 - yellow eco fireball fade (next-launcher for 5225)

(defpart 5223
  :init-specs ((:texture (lightning-anim-01 level-default-sprite))
    (:num 1.0 2.0)
    (:scale-x (meters 0.4) (meters 0.6))
    (:rot-x 4)
    (:rot-z (degrees 0) (degrees 360))
    (:scale-y (meters 2.0) (meters 1.0))
    (:r 64.0)
    (:g 64.0)
    (:b 192.0)
    (:a 128.0)
    (:fade-a -1.6)
    (:timer (seconds 0.3))
    (:flags (sp-cpuinfo-flag-0 sp-cpuinfo-flag-2 sp-cpuinfo-flag-3))
    (:next-time (seconds 0.035))
    (:next-launcher 5224)
    )
  )

(defpart 5224
  :init-specs ((:r 64.0)
    (:g 64.0)
    (:fade-r -2.0)
    (:fade-g -0.8)
    (:fade-a -4.0)
    )
  )

(defpart 5225
  :init-specs ((:texture (hotdot level-default-sprite))
    (:num 0.5 2.0)
    (:y (meters -0.05))
    (:scale-x (meters 0.2) (meters 0.1))
    (:scale-y :copy scale-x)
    (:r 100.0 28.0)
    (:g 64.0 64.0)
    (:b 0.0)
    (:a 64.0 64.0)
    (:vel-y (meters 0.002) (meters 0.001))
    (:scalevel-x (meters -0.00083333335))
    (:scalevel-y :copy scalevel-x)
    (:fade-g -0.4)
    (:fade-a -0.024)
    (:accel-y (meters -0.0001) (meters -0.0003))
    (:friction 0.93)
    (:timer (seconds 0.8))
    (:flags (sp-cpuinfo-flag-2 sp-cpuinfo-flag-3))
    (:next-time (seconds 0.3))
    (:next-launcher 5226)
    (:conerot-x (degrees 0) (degrees 180))
    (:conerot-y (degrees 0) (degrees 360))
    (:conerot-radius (meters 0.05))
    )
  )

(defpart 5226
  :init-specs ((:fade-r 0.0))
  )