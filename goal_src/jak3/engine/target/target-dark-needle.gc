;;-*-Lisp-*-
(in-package goal)

;; name: target-dark-needle.gc
;; name in dgo: target-dark-needle
;; dgos: GAME
;;
;; Dark needle projectile ability for Dark Jak.
;; Light trail ported from gun-blue-shot-3, recolored dark eco.
;; Uses light-trail-tracker-projectile as base (same as blue shot).
;; IMPORTANT: restart REPL before compiling if type errors occur.

(define-extern *djak-ability-mode* symbol)
(define-extern projectile-init-by-other (function projectile-init-by-other-params object :behavior projectile))
(define-extern dark-needle-spawn-single (function vector vector float none))
;; ============================================================
;; Charge state globals
;; ============================================================
(define *dark-needle-charging*         #f)
(define *dark-needle-charge-frames*    0)
(define *dark-needle-charge-level*     0)
(define *dark-needle-aura-pulse-timer* 0)
(define *dark-needle-fire-pending*     #f)
(define *dark-needle-fire-level*       0)

(define *dark-needle-cooldown* 0)
(define *dn-spawn-pending-2* #f)
(define *dn-spawn-pending-3* #f)
(define *dn-spawn-timer-2* (the int 10))
(define *dn-spawn-timer-3* (the int 20))
;; Change the global to store a process pointer
(define *dn-excluded-0* (the-as process #f))
(define *dn-excluded-1* (the-as process #f))
(define *dn-excluded-2* (the-as process #f))

;; ============================================================
;; defpart 5273 -- dark needle fallback particle
;; ============================================================
(defpart 5273
  :init-specs ((:texture (bigpuff level-default-sprite))
    (:num 1.0)
    (:x (meters -0.3) (meters 0.6))
    (:scale-x (meters 1.5) (meters 1.0))
    (:rot-z (degrees 0) (degrees 3600))
    (:scale-y :copy scale-x)
    (:r 30.0 20.0)
    (:g 0.0)
    (:b 180.0 60.0)
    (:a 48.0 48.0)
    (:vel-y (meters -0.005) (meters -0.005))
    (:scalevel-x (meters 0.004) (meters 0.006))
    (:rotvel-z (degrees -0.2) (degrees 0.4))
    (:scalevel-y :copy scalevel-x)
    (:fade-a -0.6 -0.8)
    (:friction 0.97 0.02)
    (:timer (seconds 0.3))
    (:flags (sp-cpuinfo-flag-2 sp-cpuinfo-flag-12))
    (:rotate-y (degrees 0) (degrees 3600))
    )
  )

;; ============================================================
;; defpart 5274 -- dark shockwave charging aura
;; ============================================================
(defpart 5274
  :init-specs ((:texture (water-radiate level-default-sprite))
    (:num 6.0)
    (:scale-x (meters 2) (meters 1))
    (:rot-x 4)
    (:scale-y :copy scale-x)
    (:r 15.0 10.0)
    (:g 0.0)
    (:b 160.0 60.0)
    (:a 200.0 55.0)
    (:scalevel-x (meters 0.08) (meters 0.04))
    (:scalevel-y :copy scalevel-x)
    (:fade-a -2.0)
    (:timer (seconds 0.5))
    (:flags (sp-cpuinfo-flag-2 sp-cpuinfo-flag-3))
    )
  )

;; ============================================================
;; Custom dark-eco purple color curve
(define *dark-needle-color-curve* (new 'loading-level 'curve-color-piecewise))
(allocate! *dark-needle-color-curve* 3 'loading-level #f)
;; tip: bright purple-white core
(set! (-> *dark-needle-color-curve* pts data 0 first)     0.0)
(set! (-> *dark-needle-color-curve* pts data 0 second x)  0.6)
(set! (-> *dark-needle-color-curve* pts data 0 second y)  0.0)
(set! (-> *dark-needle-color-curve* pts data 0 second z)  1.0)
(set! (-> *dark-needle-color-curve* pts data 0 second w)  1.0)
;; mid: deep purple
(set! (-> *dark-needle-color-curve* pts data 1 first)     0.5)
(set! (-> *dark-needle-color-curve* pts data 1 second x)  0.5)
(set! (-> *dark-needle-color-curve* pts data 1 second y)  0.0)
(set! (-> *dark-needle-color-curve* pts data 1 second z)  0.8)
(set! (-> *dark-needle-color-curve* pts data 1 second w)  1.0)
;; tail: near-black dark eco purple
(set! (-> *dark-needle-color-curve* pts data 2 first)     1.0)
(set! (-> *dark-needle-color-curve* pts data 2 second x)  0.15)
(set! (-> *dark-needle-color-curve* pts data 2 second y)  0.0)
(set! (-> *dark-needle-color-curve* pts data 2 second z)  0.25)
(set! (-> *dark-needle-color-curve* pts data 2 second w)  1.0)
;; ============================================================
(define *dark-needle-trail* (new 'loading-level 'light-trail-composition))

(set! (-> *dark-needle-trail* color-mode)        (the-as uint 0))
(set! (-> *dark-needle-trail* color-repeat-dist)  40960.0)
(set! (-> *dark-needle-trail* alpha-1-mode)       (the-as uint 0))
(set! (-> *dark-needle-trail* alpha-2-mode)       (the-as uint 6))
(set! (-> *dark-needle-trail* base-alpha)          1.0)
(set! (-> *dark-needle-trail* alpha-repeat-dist)   94208.0)
(set! (-> *dark-needle-trail* width-mode)         (the-as uint 2))
(set! (-> *dark-needle-trail* base-width)          17192.0)
(set! (-> *dark-needle-trail* width-repeat-dist)   12288.0)
(set! (-> *dark-needle-trail* uv-mode)            (the-as uint 0))
(set! (-> *dark-needle-trail* uv-repeat-dist)      163840.0)
(set! (-> *dark-needle-trail* lie-mode)           (lie-mode appearance0))
(set! (-> *dark-needle-trail* max-age)            (seconds 2.5))
(set! (-> *dark-needle-trail* tex-id)             (new 'static 'texture-id :index #xf :page #x5))
(set! (-> *dark-needle-trail* width-curve)        (the-as curve2d-piecewise *curve-linear-up*))
(set! (-> *dark-needle-trail* color-curve)        (the-as curve-color-piecewise *dark-needle-color-curve*))
(set! (-> *dark-needle-trail* alpha-curve-1)      (the-as curve2d-piecewise *curve-linear-down*))
(set! (-> *dark-needle-trail* alpha-curve-2)      #f)
(set! (-> *dark-needle-trail* zbuffer?)            #f)
(vector-copy! (-> *dark-needle-trail* lie-vector) *up-vector*)
(set! (-> *dark-needle-trail* use-tape-mode?)      #f)
(set! (-> *dark-needle-trail* blend-mode)         (the-as uint 1))
(set! (-> *dark-needle-trail* frame-stagger)      (the-as uint 1))

;; ============================================================
;; light-trail-tracker-dark-needle
;; Matches light-trail-tracker-blue-3 exactly.
;; ============================================================
(deftype light-trail-tracker-dark-needle (light-trail-tracker-projectile)
  ()
  )

(defmethod should-track? ((this light-trail-tracker-dark-needle) (arg0 process-focusable))
  #t
  )

;; ============================================================
;; dark-needle-shot projectile type
;; ============================================================
(declare-type dark-needle-shot projectile)
(deftype dark-needle-shot (projectile)
  ((hit-actor?              symbol)
   (start-pos               vector  :inline)
   (track-mode              uint64)
   (random-travel-distance  float)
   (size-scalar             float)
   )
  (:state-methods
    dissipate
    impact
    )
  )
(defmethod setup-collision! ((this dark-needle-shot))
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-projectile)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (let ((v1-6 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-6 prim-core collide-as) (collide-spec projectile))
      (set! (-> v1-6 prim-core collide-with)
            (collide-spec backgnd crate civilian enemy obstacle vehicle-sphere hit-by-others-list pusher)
            )
      (set! (-> v1-6 prim-core action) (collide-action solid))
      (set-vector! (-> v1-6 local-sphere) 0.0 0.0 0.0 2048.0)
      (set! (-> s5-0 total-prims) (the-as uint 1))
      (set! (-> s5-0 root-prim) v1-6)
      )
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-9 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-9 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-9 prim-core collide-with))
      )
    (set! (-> s5-0 max-iteration-count) (the-as uint 1))
    (set! (-> s5-0 event-self) 'touched)
    (set! (-> this root) s5-0)
    )
  (set! (-> this root pat-ignore-mask)
        (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noproj #x1 :noendlessfall #x1 :board #x1)
        )
  0
  (none)
  )

(defun dark-needle-shot-move ((arg0 dark-needle-shot))
  (when (= (-> arg0 desired-target) (the-as handle #f))
    (let ((best-proc (the-as process #f))
          (best-dist 204800.0)
          (search-pos (new 'stack-no-clear 'vector))
          (cam-fwd    (new 'stack-no-clear 'vector))
          )
      (vector-copy! search-pos (-> arg0 root trans))
      (set! (-> search-pos w) 204800.0)
      (vector-normalize-copy! cam-fwd (-> (camera-matrix) fvec) 1.0)
      (let ((actors (new 'stack-no-clear 'array 'collide-shape 64)))
        (countdown (i (fill-actor-list-for-box *actor-hash* search-pos actors 64))
          (let ((cshape (-> actors i)))
            (when (and cshape (-> cshape root-prim))
              (let* ((proc (-> cshape process))
                     (focusable (as-type proc process-focusable))
                     )
                (when (and proc
                           focusable
                           (logtest? (process-mask enemy guard civilian) (-> proc mask))
                           (not (focus-test? focusable dead inactive disable))
                           (not (= (the-as int proc) (the-as int *dn-excluded-0*)))
                           (not (= (the-as int proc) (the-as int *dn-excluded-1*)))
                           (not (= (the-as int proc) (the-as int *dn-excluded-2*)))
                           )
                  (let* ((to-proc (new 'stack-no-clear 'vector))
                         (dummy (vector-! to-proc (-> cshape root-prim prim-core world-sphere) search-pos))
                         (dot (vector-dot cam-fwd (vector-normalize-copy! (new 'stack-no-clear 'vector) to-proc 1.0)))
                         )
                    (when (and (> dot 0.0)
                               (< (vector-vector-distance search-pos (-> cshape root-prim prim-core world-sphere)) best-dist)
                               )
                      (set! best-dist (vector-vector-distance search-pos (-> cshape root-prim prim-core world-sphere)))
                      (set! best-proc proc)
                      )
                    )
                  )
                )
              )
            )
          )
        )
      (if best-proc
          (begin
            (set! (-> arg0 desired-target) (process->handle best-proc))
            (cond
              ((= (the-as int *dn-excluded-0*) (the-as int #f))
               (set! *dn-excluded-0* best-proc)
               )
              ((= (the-as int *dn-excluded-1*) (the-as int #f))
               (set! *dn-excluded-1* best-proc)
               )
              (else
               (set! *dn-excluded-2* best-proc)
               )
              )
            )
          (set! (-> arg0 desired-target) (the-as handle -1))
          )
      )
    )
  (let* ((age (- (current-time) (-> arg0 spawn-time)))
         (arc-phase (< age (seconds 0.9)))
         (raw-proc (handle->process (-> arg0 desired-target)))
         (targ-proc (as-type raw-proc process-focusable))
         )
    (when (and targ-proc
               (focus-test? targ-proc dead inactive disable)
               )
      (set! (-> arg0 desired-target) (the-as handle -1))
      (set! targ-proc (the-as process-focusable #f))
      )
    (cond
      (arc-phase
        (+! (-> arg0 root transv y) (* 120123.0 (seconds-per-frame)))
        (vector-normalize! (-> arg0 root transv) (vector-length (-> arg0 root transv)))
        )
      ((and targ-proc
            (nonzero? (-> targ-proc root))
            )
       (let* ((target-pos (-> targ-proc root trans))
              (to-targ    (new 'stack-no-clear 'vector))
              (cur-speed  (vector-length (-> arg0 root transv)))
              (spread-angle (the float (the int (-> arg0 track-mode))))
              )
         (vector-! to-targ target-pos (-> arg0 root trans))
         (when (!= spread-angle 0.0)
           (vector-rotate-y! to-targ to-targ spread-angle)
           )
         (vector-normalize! to-targ cur-speed)
         (vector-lerp! (-> arg0 root transv) (-> arg0 root transv) to-targ 0.25)
         (vector-normalize! (-> arg0 root transv) cur-speed)
         )
       )
      )
    )
 (when (not (= (-> arg0 desired-target) (the-as handle -1)))
  (let* ((check-proc (handle->process (-> arg0 desired-target)))
         (check-focusable (as-type check-proc process-focusable))
         )
    (when (or (not check-proc)
              (not check-focusable)
              (focus-test? check-focusable dead inactive)
              )
      (set! (-> arg0 desired-target) (the-as handle -1))
      )
    )
  )
  (projectile-move-fill-line-sphere arg0)
  (if (logtest? (-> arg0 root status) (collide-status touch-surface touch-actor))
      (go (method-of-object arg0 impact))
      )
  0
  (none)
  )

(defun dark-needle-do-spawn ((level int))
  (when *target*
    (let ((fire-point (new 'stack-no-clear 'vector))
          (fwd        (new 'stack-no-clear 'vector))
          (aim-pos    (new 'stack-no-clear 'vector))
          )
      (vector-copy! fire-point (-> *target* control trans))
      (+! (-> fire-point y) 4096.0)
      (vector-copy! fwd (-> (camera-matrix) fvec))
      (set! (-> fwd y) 0.0)
      (vector-normalize! fwd 163840.0)
      (vector+! aim-pos fire-point fwd)
      ;; Reset all exclusion slots for new burst
      (set! *dn-excluded-0* (the-as process #f))
      (set! *dn-excluded-1* (the-as process #f))
      (set! *dn-excluded-2* (the-as process #f))
      (dark-needle-spawn-single fire-point aim-pos 0.0)
      (set! *dn-spawn-pending-2* #f)
      (set! *dn-spawn-pending-3* #f)
      (when (>= level 2)
        (set! *dn-spawn-timer-2* 30)
        (set! *dn-spawn-pending-2* #t)
        )
      (when (>= level 3)
        (set! *dn-spawn-timer-3* 60)
        (set! *dn-spawn-pending-3* #t)
        )
      )
    )
  0
  (none)
  )


(defmethod projectile-method-25 ((this dark-needle-shot))
  ;; Visual handled by light-trail-tracker-dark-needle child
  0
  (none)
  )

(defmethod init-proj-settings! ((this dark-needle-shot))
  (set! (-> this attack-mode) 'dark-smack)
  (set! (-> this max-speed) 89000.0)
  (set! (-> this move) (the-as (function projectile none) dark-needle-shot-move))
  (set! (-> this timeout) (seconds 3))
  (set! (-> this damage) 3.0)
  (set! (-> this vehicle-damage-factor) 2.0)
  (set! (-> this vehicle-impulse-factor) 2.0)
  (set! (-> this max-hits) 1)
  (set! (-> this size-scalar) 1.0)
  (vector-copy! (-> this start-pos) (-> this root trans))
  ;; Spawn light trail tracker -- vanilla pattern from gun-blue-shot-3
  (let ((s5-0 (new 'stack-no-clear 'light-trail-tracker-spawn-params)))
    (set! (-> s5-0 tracked-obj) (process->handle this))
    (set! (-> s5-0 appearance) *dark-needle-trail*)
    (set! (-> s5-0 max-num-crumbs) 90)
    (set! (-> s5-0 track-immediately?) #t)
    (let* ((v1-0 (estimate-light-trail-mem-usage
                   (the-as uint (-> s5-0 max-num-crumbs))
                   (the-as uint (= (-> s5-0 appearance lie-mode) (lie-mode use-two-strips)))
                   )
                 )
           (s4-0 (get-process *default-dead-pool* light-trail-tracker-dark-needle (+ v1-0 #x8000) 1))
           )
    
      (when s4-0
        (let ((t9-0 (method-of-type process activate)))
          (t9-0 s4-0 this "light-trail" (the-as pointer #x70004000))
          )
        (run-now-in-process s4-0 light-trail-tracker-init-by-other s5-0)
        
        (-> s4-0 ppointer)
        )
      )
    )
  0
  (none)
  )

(defstate dissipate (dark-needle-shot)
  :virtual #t
  :enter (behavior ()
    (none)
    )
  )

(defstate impact (dark-needle-shot)
  :virtual #t
  :enter (behavior ()
    (none)
    )
  )

  (defmethod projectile-method-40 ((this dark-needle-shot))
  1024
  )
;; ============================================================
;; dark-needle-spawn-single
;; ============================================================
(defun dark-needle-spawn-single ((fire-point vector) (aim-pos vector) (angle-offset float))
  (let ((needle-dir (new 'stack-no-clear 'vector))
        (fire-dir   (new 'stack-no-clear 'vector))
        )
    (vector-! fire-dir aim-pos fire-point)
    (vector-normalize! fire-dir 1.0)
    (vector-rotate-y! needle-dir fire-dir angle-offset)
    (vector-normalize! needle-dir 1.0)
    (let ((gp-0 (new 'stack-no-clear 'projectile-init-by-other-params)))
      (set! (-> gp-0 ent) (-> *target* entity))
      (set! (-> gp-0 charge) 1.0)
      (set! (-> gp-0 options) (projectile-options))
      (logclear! (-> gp-0 options) (projectile-options po14 po15 po16))
      (vector-copy! (-> gp-0 pos) fire-point)
      (set! (-> gp-0 notify-handle) (the-as handle #f))
      (set! (-> gp-0 owner-handle) (process->handle *target*))
      (set! (-> gp-0 target-handle) (the-as handle #f))
      (vector-copy! (-> gp-0 target-pos) aim-pos)
      (set! (-> gp-0 ignore-handle) (process->handle *target*))
      (let* ((v1-0 *game-info*)
             (a0-0 (+ (-> v1-0 attack-id) 1))
             )
        (set! (-> v1-0 attack-id) a0-0)
        (set! (-> gp-0 attack-id) a0-0)
        )
      (set! (-> gp-0 timeout) (seconds 3))
      (vector-float*! (-> gp-0 vel) needle-dir 84000.0)
      (let ((needle-proc (get-process *default-dead-pool* dark-needle-shot #x8000 1)))
        (when needle-proc
          (activate needle-proc *target* "dark-needle" (the-as pointer #x70004000))
          (run-now-in-process needle-proc projectile-init-by-other gp-0)
           (set! (-> (the-as dark-needle-shot (ppointer->process (-> needle-proc ppointer))) track-mode)
               (the-as uint (the int angle-offset))
                )
          (-> needle-proc ppointer)
          )
        )
      )
    )
  0
  (none)
  )


;; ============================================================
;; dark-needle-circle-check
;; ============================================================
(defun dark-needle-circle-check ()
  ;; Tick cooldown every frame
  (when (> *dark-needle-cooldown* 0)
    (+! *dark-needle-cooldown* -1)
    )
  (when (and *djak-ability-mode* *target*)
    (let ((cpad-num (-> *target* control cpad number)))
      (cond
        ((not *dark-needle-charging*)
         (when (and (cpad-hold? cpad-num circle)
                    (= *dark-needle-cooldown* 0)
                    )
           (let ((sname (-> *target* state name)))
             (when (or (= sname 'target-stance)
                       (= sname 'target-walk)
                       (= sname 'target-duck-stance)
                       )
               (set! *dark-needle-charging* #t)
               (set! *dark-needle-charge-frames* 0)
               (set! *dark-needle-charge-level* 1)
               (sound-play "djak-bolt-charg")
               (format #t "[DARK-NEEDLE] charge started~%")
               )
             )
           )
         )
        (*dark-needle-charging*
         (+! *dark-needle-charge-frames* 1)
         (set! *dark-needle-charge-level*
               (cond
                 ((>= *dark-needle-charge-frames* 320) 3)
                 ((>= *dark-needle-charge-frames* 160) 2)
                 (else                                 1)
                 )
               )
         (cond
           ((or (not (cpad-hold? cpad-num circle))
                (>= *dark-needle-charge-frames* 480)
                )
            (when (>= *dark-needle-charge-frames* 480)
              (set! *dark-needle-charge-level* 3)
              )
            (format #t "[DARK-NEEDLE] fire lvl ~D~%" *dark-needle-charge-level*)
            (sound-play "djak-bolt-throw")
            (cpad-set-buzz! (-> *cpad-list* cpads 0) 1 200 (seconds 0.2))
            (set! *dark-needle-fire-pending* #t)
            (set! *dark-needle-fire-level* *dark-needle-charge-level*)
            (set! *dark-needle-charging* #f)
            (set! *dark-needle-charge-frames* 0)
            (set! *dark-needle-charge-level* 0)
            (set! *dark-needle-cooldown* 500)
            )
           (else
            )
           )
         )
        )
      )
    )
  ;; Deferred shot spawning -- stagger shots so they never hit simultaneously
  (when *dn-spawn-pending-2*
    (if (= *dn-spawn-timer-2* 0)
        (begin
          (when *target*
            (let ((fire-point (new 'stack-no-clear 'vector))
                  (fwd        (new 'stack-no-clear 'vector))
                  (aim-pos    (new 'stack-no-clear 'vector))
                  )
              (vector-copy! fire-point (-> *target* control trans))
              (+! (-> fire-point y) 4096.0)
              (vector-copy! fwd (-> (camera-matrix) fvec))
              (set! (-> fwd y) 0.0)
              (vector-normalize! fwd 163840.0)
              (vector+! aim-pos fire-point fwd)
              (dark-needle-spawn-single fire-point aim-pos 2730.6667)
              )
            )
          (set! *dn-spawn-pending-2* #f)
          )
        (+! *dn-spawn-timer-2* -1)
        )
    )
  (when *dn-spawn-pending-3*
    (if (= *dn-spawn-timer-3* 0)
        (begin
          (when *target*
            (let ((fire-point (new 'stack-no-clear 'vector))
                  (fwd        (new 'stack-no-clear 'vector))
                  (aim-pos    (new 'stack-no-clear 'vector))
                  )
              (vector-copy! fire-point (-> *target* control trans))
              (+! (-> fire-point y) 4096.0)
              (vector-copy! fwd (-> (camera-matrix) fvec))
              (set! (-> fwd y) 0.0)
              (vector-normalize! fwd 163840.0)
              (vector+! aim-pos fire-point fwd)
              (dark-needle-spawn-single fire-point aim-pos -2730.6667)
              )
            )
          (set! *dn-spawn-pending-3* #f)
          )
        (+! *dn-spawn-timer-3* -1)
        )
    )
  (when (and (not *djak-ability-mode*) *dark-needle-charging*)
    (set! *dark-needle-charging* #f)
    (set! *dark-needle-charge-frames* 0)
    (set! *dark-needle-charge-level* 0)
    )
  0
  (none)
  )
