;;-*-Lisp-*-
(in-package goal)

;; name: target-dark-doppel.gc
;; Dark Jak Orbital Defense System.
;; 3 orbs orbit Jak at 5m radius, each autonomously firing orb-bolt projectiles
;; at the nearest enemy every 5 seconds (staggered, 360-degree targeting).
;; orb-bolt is a projectile subtype modeled after metalhead-shot:
;;   - glow head particle each frame
;;   - impact reuses group-metalhead-shot-hit (already dark purple)

;; ============================================================
;; Orb visual parts — unstable dark eco lightning orb
;; Crackling animated lightning arcs around a tight hotdot core,
;; with a flickering glow pulse that sells the instability.
;; ============================================================

;; 5275 -- lightning arcs (lightning-anim-01: animated crackling arcs)
;; birth-func-texture-group cycles through animation frames randomly
;; giving the unstable flickering electric look
(defpart 5275
  :init-specs ((:texture (lightning-anim-01 level-default-sprite))
    (:birth-func 'birth-func-texture-group)
    (:num 3.0 2.0)
    (:scale-x (meters 0.6) (meters 0.3))
    (:rot-z (degrees 0) (degrees 3600))
    (:scale-y (meters 0.6) (meters 0.3))
    (:r 80.0 60.0)
    (:g 0.0 20.0)
    (:b 255.0)
    (:a 200.0 55.0)
    (:vel-x (meters -0.006) (meters 0.012))
    (:vel-y (meters -0.004) (meters 0.008))
    (:vel-z (meters -0.006) (meters 0.012))
    (:scalevel-x (meters 0.003) (meters 0.002))
    (:scalevel-y :copy scalevel-x)
    (:fade-a -3.0)
    (:friction 0.88)
    (:timer (seconds 0.2))
    (:flags (sp-cpuinfo-flag-2 sp-cpuinfo-flag-3))
    (:conerot-x (degrees 0) (degrees 3600))
    (:conerot-y (degrees 0) (degrees 3600))
    (:conerot-radius (meters 0.0) (meters 0.35))
    )
  )

;; 5276 -- dark eco core (glow: dim violet-purple, not a white dot)
(defpart 5276
  :init-specs ((:texture (glow level-default-sprite))
    (:num 1.0)
    (:scale-x (meters 0.6) (meters 0.2))
    (:rot-x (degrees 4.5))
    (:rot-z (degrees 0) (degrees 3600))
    (:scale-y :copy scale-x)
    (:r 80.0 40.0)
    (:g 0.0)
    (:b 180.0 60.0)
    (:a 100.0 60.0)
    (:omega (degrees 4515.75))
    (:scalevel-x (meters -0.005))
    (:scalevel-y :copy scalevel-x)
    (:fade-a -2.5)
    (:timer (seconds 0.13))
    (:flags (sp-cpuinfo-flag-2 sp-cpuinfo-flag-3 sp-cpuinfo-flag-14 glow))
    (:userdata 1024.0)
    )
  )

;; 5277 -- unstable pulse (glow: randomized alpha for flickering instability)
;; Large random alpha range makes it visibly flicker each frame
(defpart 5277
  :init-specs ((:texture (glow level-default-sprite))
    (:num 1.0)
    (:scale-x (meters 0.8) (meters 0.5))
    (:rot-x (degrees 4.5))
    (:rot-z (degrees 0) (degrees 3600))
    (:scale-y :copy scale-x)
    (:r 60.0 40.0)
    (:g 0.0)
    (:b 200.0 55.0)
    (:a 40.0 120.0)
    (:omega (degrees 4515.75))
    (:scalevel-x (meters -0.008))
    (:scalevel-y :copy scalevel-x)
    (:fade-a -2.0)
    (:timer (seconds 0.15))
    (:flags (sp-cpuinfo-flag-2 sp-cpuinfo-flag-3 sp-cpuinfo-flag-14 glow))
    (:userdata 1024.0)
    )
  )

