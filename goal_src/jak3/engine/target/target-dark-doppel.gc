;; ============================================================
;; orb-bolt projectile type
;; ============================================================
(deftype orb-bolt (projectile)
  ((tail-pos    vector    :inline)
   (fire-pos    vector    :inline)
   (fire-sound  sound-id)
   (home-handle handle)
   )
  )

(defmethod deactivate ((this orb-bolt))
  (sound-stop (-> this fire-sound))
  (call-parent-method this)
  (none)
  )

(defun orb-bolt-move ((arg0 orb-bolt))
  (set! (-> arg0 root status) (collide-status))
  ;; Homing: steer transv toward target's current position each frame
  (let ((home-proc (handle->process (-> arg0 home-handle))))
    (when (and home-proc (nonzero? (-> (the-as process-focusable home-proc) root)))
      (let* ((to-target  (vector-! (new 'stack-no-clear 'vector)
                                   (-> (the-as process-focusable home-proc) root trans)
                                   (-> arg0 root trans)))
             (dist       (vector-length to-target))
             )
        (when (< dist 4096.0)
          (go (method-of-object arg0 impact))
          )
        ;; Normalize desired direction, lerp transv toward it, renormalize at speed
        (vector-normalize! to-target 1.0)
        (let ((cur-dir (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> arg0 root transv) 1.0)))
          (vector-lerp! cur-dir cur-dir to-target 0.05)
          (vector-normalize-copy! (-> arg0 root transv) cur-dir 2048.0)
          )
        )
      )
    )
  (vector+! (-> arg0 root trans) (-> arg0 root trans) (-> arg0 root transv))
  ;; Spin ~6 degrees/frame around Y axis
  (quaternion-rotate-y! (-> arg0 root quat) (-> arg0 root quat) 1092.2667)
  (update-transforms (-> arg0 root))
  0
  (none)
  )

(defstate impact (orb-bolt)
  :virtual #t
  :code (behavior ()
    (projectile-method-26 self)
    (deactivate self)
    )
  )

(defstate dissipate (orb-bolt)
  :virtual #t
  :code (behavior ()
    (deactivate self)
    )
  )

(defmethod projectile-method-24 ((this orb-bolt))
  (set! (-> *launch-matrix* trans quad) (-> this root trans quad))
  (sp-launch-particles-var
    *sp-particle-system-2d*
    (-> *part-id-table* 5275)
    *launch-matrix*
    (the-as sparticle-launch-state #f)
    (the-as sparticle-launch-control #f)
    1.0)
  0
  (none)
  )

(defmethod projectile-method-25 ((this orb-bolt))
  (let ((head-pos (-> this root trans)))
    (set! (-> *launch-matrix* trans quad) (-> head-pos quad))
    (sp-launch-particles-var
      *sp-particle-system-2d*
      (-> *part-id-table* 5278)
      *launch-matrix*
      (the-as sparticle-launch-state #f)
      (the-as sparticle-launch-control #f)
      1.0)
    (sp-launch-particles-var
      *sp-particle-system-2d*
      (-> *part-id-table* 5279)
      *launch-matrix*
      (the-as sparticle-launch-state #f)
      (the-as sparticle-launch-control #f)
      1.0)
    (sp-launch-particles-var
      *sp-particle-system-2d*
      (-> *part-id-table* 5280)
      *launch-matrix*
      (the-as sparticle-launch-state #f)
      (the-as sparticle-launch-control #f)
      1.0)
    (sp-launch-particles-var
      *sp-particle-system-2d*
      (-> *part-id-table* 5281)
      *launch-matrix*
      (the-as sparticle-launch-state #f)
      (the-as sparticle-launch-control #f)
      1.0)
    )
  0
  (none)
  )

(defmethod projectile-method-26 ((this orb-bolt))
  (set! (-> *launch-matrix* trans quad) (-> this root trans quad))
  (sp-launch-particles-var
    *sp-particle-system-2d*
    (-> *part-id-table* 5282)
    *launch-matrix*
    (the-as sparticle-launch-state #f)
    (the-as sparticle-launch-control #f)
    1.0)
  (sp-launch-particles-var
    *sp-particle-system-2d*
    (-> *part-id-table* 5283)
    *launch-matrix*
    (the-as sparticle-launch-state #f)
    (the-as sparticle-launch-control #f)
    1.0)
  (activate! *camera-smush-control* 409.6 6 30 1.0 0.95 (-> *display* camera-clock))
  (let ((home-proc (handle->process (-> this home-handle))))
    (when home-proc
      (let ((attack (new 'stack 'attack-info)))
        (set! (-> attack mode) 'dark-smack)
        (set! (-> attack id) (-> this attack-id))
        (set! (-> attack mask) (attack-mask mode id))
        (set! (-> attack penetrate-using) (penetrate dark-smack dark-skin dark-bomb))
        (set! (-> attack damage) 6.0)
        (set! (-> attack vehicle-damage-factor) 1.0)
        (set! (-> attack vehicle-impulse-factor) 2.0)
        (logior! (-> attack mask) (attack-mask damage vehicle-damage-factor vehicle-impulse-factor))
        (set! (-> attack attacker) (-> this owner-handle))
        (logior! (-> attack mask) (attack-mask attacker))
        (send-event home-proc 'attack #f attack)
        )
      )
    )
  0
  (none)
  )

(defmethod setup-collision! ((this orb-bolt))
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-projectile)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing))
    (let ((v1-0 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-0 prim-core collide-as) (collide-spec))
      (set! (-> v1-0 prim-core collide-with)
            (collide-spec crate civilian enemy vehicle-sphere hit-by-others-list))
      (set! (-> v1-0 prim-core action) (collide-action solid))
      (set-vector! (-> v1-0 local-sphere) 0.0 0.0 0.0 2048.0)
      (set! (-> s5-0 total-prims) (the-as uint 1))
      (set! (-> s5-0 root-prim) v1-0)
      )
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-1 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as)   (-> v1-1 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-1 prim-core collide-with))
      )
    (set! (-> s5-0 max-iteration-count) (the-as uint 2))
    (set! (-> s5-0 event-self) 'touched)
    (set! (-> this root) s5-0)
    )
  (set! (-> this root pat-ignore-mask)
        (new 'static 'pat-surface
             :noentity #x1 :nojak #x1 :probe #x1 :noproj #x1 :noendlessfall #x1 :board #x1))
  0
  (none)
  )

(defmethod init-proj-settings! ((this orb-bolt))
  (vector-copy! (-> this tail-pos) (-> this root trans))
  (set! (-> this attack-mode)            'dark-smack)
  (set! (-> this max-speed)              2048.0)
  (set! (-> this move) orb-bolt-move)
  (set! (-> this timeout)                (seconds 20.0))
  (set! (-> this damage)                 6.0)
  (set! (-> this vehicle-damage-factor)  1.0)
  (set! (-> this vehicle-impulse-factor) 2.0)
  (set! (-> this max-hits)               1)
  (set! (-> this fire-sound)             (new-sound-id))
  (vector-copy! (-> this fire-pos) (-> this root trans))
  0
  (none)
  )

;; ============================================================
;; Constants
;; ============================================================
(define *doppel-orb-radius*    20480.0)   ;; 5m
(define *doppel-orb-height*    4915.2)    ;; 1.2m
(define *doppel-orb-speed*     136.533)   ;; binary-angle units/frame = 8s orbit
(define *doppel-fire-interval* 300)       ;; 5s at 60fps -- time between each shot in the rotation
(define *doppel-search-radius* 204800.0)  ;; 50m

;; ============================================================
;; Globals (extern-compatible names retained)
;; ============================================================
(define *doppel-active*        #f)
(define *doppel-draining*      #f)
(define *doppel-drain-counter* (the int 0))
(define *doppel-handle*        (the-as handle 0))
(define *doppel-write-idx*     (the int 0))
(define *doppel-delay-frames*  30)
(define *doppel-buffer-size*   60)
(define *doppel-buffer*        (the-as pointer #f))
(define *doppel-timer-start*   (the time-frame 0))
(define *doppel-duration*      (seconds 15))

(define *doppel-orb-angle-0*   0.0)
(define *doppel-orb-angle-1*   21845.333)
(define *doppel-orb-angle-2*   43690.667)
(define *doppel-fire-rotation-timer* 0)   ;; counts down to next shot in the rotation
(define *doppel-fire-next-orb*       0)   ;; index (0-2) of which orb fires next

(define *djak-blink-modifier*  #f)
(define *djak-doppel-modifier* #f)

;; ============================================================
;; Stubs
;; ============================================================
(defun doppel-stamp-shot ((origin vector) (dir vector) (target handle)) (none))
(defun doppel-stamp-punch ((origin vector) (dir vector)) (none))
(defun doppel-stamp-blink ((target handle)) (none))
(defun doppel-stamp-zone-toggle () (none))

(defun doppel-deactivate ()
  (when *doppel-active*
    (set! *doppel-active* #f)
    (format #t "[DOPPEL] deactivated~%")
    )
  (none)
  )

(defun doppel-get-orb-pos ((out vector) (angle float))
  (let ((jak-pos (-> *target* control trans)))
    (set! (-> out x) (+ (-> jak-pos x) (* *doppel-orb-radius* (sin angle))))
    (set! (-> out y) (+ (-> jak-pos y) *doppel-orb-height*))
    (set! (-> out z) (+ (-> jak-pos z) (* *doppel-orb-radius* (cos angle))))
    (set! (-> out w) 1.0)
    )
  (none)
  )

(defun doppel-find-nearest-enemy ((from-pos vector))
  (let* ((result     (the-as handle 0))
         (sphere     (new 'stack-no-clear 'vector))
         (actor-list (new 'stack-no-clear 'array 'collide-shape 384))
         )
    (vector-copy! sphere from-pos)
    (set! (-> sphere w) *doppel-search-radius*)
    (let ((hit-count (fill-actor-list-for-box *actor-hash* sphere actor-list 384)))
      (let ((best-dist *doppel-search-radius*))
        (dotimes (i hit-count)
          (let ((proc (as-type (-> actor-list i) collide-shape)))
            (when proc
              (let ((fproc (as-type (-> proc process) process-focusable)))
                (when (and fproc
                           (logtest? (process-mask enemy civilian guard bot) (-> fproc mask))
                           (not (focus-test? fproc dead))
                           (nonzero? (-> fproc root))
                           )
                  (let ((dist (vector-vector-distance from-pos (-> fproc root trans))))
                    (when (< dist best-dist)
                      (set! best-dist dist)
                      (set! result (process->handle fproc))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    result
    )
  )

(define-extern doppel-fire-orb (function vector handle none))
(defun doppel-fire-orb ((orb-pos vector) (target-handle handle))
  (let ((home-proc (handle->process target-handle)))
    (when (and home-proc (nonzero? (-> (the-as process-focusable home-proc) root)))
      (let ((gp-0 (new 'stack-no-clear 'projectile-init-by-other-params)))
        (set! (-> gp-0 ent)             (-> *target* entity))
        (set! (-> gp-0 charge)          1.0)
        (set! (-> gp-0 options)         (projectile-options))
        (logclear! (-> gp-0 options) (projectile-options po14 po15 po16))
        (set! (-> gp-0 notify-handle)   (the-as handle 0))
        (set! (-> gp-0 owner-handle)    (process->handle *target*))
        (set! (-> gp-0 target-handle)   (the-as handle 0))
        (set! (-> gp-0 target-pos quad) (the-as uint128 0))
        (set! (-> gp-0 ignore-handle)   (process->handle *target*))
        (let* ((v1-0 *game-info*)
               (a0-0 (+ (-> v1-0 attack-id) 1))
               )
          (set! (-> v1-0 attack-id) a0-0)
          (set! (-> gp-0 attack-id) a0-0)
          )
        (set! (-> gp-0 timeout) (seconds 20.0))
        (vector-copy! (-> gp-0 pos) orb-pos)
        (let ((to-target (new 'stack-no-clear 'vector)))
          (vector-! to-target (-> (the-as process-focusable home-proc) root trans) orb-pos)
          (+! (-> to-target y) 4096.0)
          (vector-normalize-copy! (-> gp-0 vel) to-target 2048.0)
          )
        (vector-copy! (-> *launch-matrix* trans) orb-pos)
        (let ((s3-0 (get-process *default-dead-pool* orb-bolt #x8000 1)))
          (when s3-0
            (activate s3-0 *target* "orb-bolt" (the-as pointer #x70004000))
            (run-now-in-process s3-0 projectile-init-by-other gp-0)
            (set! (-> (the-as orb-bolt (-> s3-0 self)) home-handle) target-handle)
            )
          )
        )
      )
    )
  (none)
  )

(defun doppel-spawn-orb-particles ((orb-pos vector))
  (set! (-> *launch-matrix* trans quad) (-> orb-pos quad))
  (sp-launch-particles-var
    *sp-particle-system-2d*
    (-> *part-id-table* 5275)
    *launch-matrix*
    (the-as sparticle-launch-state #f)
    (the-as sparticle-launch-control #f)
    1.0)
  (sp-launch-particles-var
    *sp-particle-system-2d*
    (-> *part-id-table* 5276)
    *launch-matrix*
    (the-as sparticle-launch-state #f)
    (the-as sparticle-launch-control #f)
    1.0)
  (sp-launch-particles-var
    *sp-particle-system-2d*
    (-> *part-id-table* 5277)
    *launch-matrix*
    (the-as sparticle-launch-state #f)
    (the-as sparticle-launch-control #f)
    1.0)
  (none)
  )

(defun doppel-record-frame ()
  (when *doppel-active*
    (set! *doppel-orb-angle-0* (the float (mod (the int (+ *doppel-orb-angle-0* *doppel-orb-speed*)) 65536)))
    (set! *doppel-orb-angle-1* (the float (mod (the int (+ *doppel-orb-angle-1* *doppel-orb-speed*)) 65536)))
    (set! *doppel-orb-angle-2* (the float (mod (the int (+ *doppel-orb-angle-2* *doppel-orb-speed*)) 65536)))
    )
  (none)
  )

(defun doppel-update-visual ()
  (when *doppel-active*
    (let ((orb0 (new 'stack-no-clear 'vector))
          (orb1 (new 'stack-no-clear 'vector))
          (orb2 (new 'stack-no-clear 'vector))
          )
      (doppel-get-orb-pos orb0 *doppel-orb-angle-0*)
      (doppel-get-orb-pos orb1 *doppel-orb-angle-1*)
      (doppel-get-orb-pos orb2 *doppel-orb-angle-2*)
      (doppel-spawn-orb-particles orb0)
      (doppel-spawn-orb-particles orb1)
      (doppel-spawn-orb-particles orb2)
      ;; Single rotation: exactly one orb fires every *doppel-fire-interval*
      ;; frames, cycling through orb 0 -> 1 -> 2 -> 0 -> ...
      (cond
        ((<= *doppel-fire-rotation-timer* 0)
         (let ((orb-pos (case *doppel-fire-next-orb*
                           ((0) orb0)
                           ((1) orb1)
                           (else orb2)
                           )
                         ))
           (let ((tgt (doppel-find-nearest-enemy orb-pos)))
             (when (nonzero? tgt)
               (doppel-fire-orb orb-pos tgt)
               )
             )
           )
         (set! *doppel-fire-next-orb* (mod (+ *doppel-fire-next-orb* 1) 3))
         (set! *doppel-fire-rotation-timer* *doppel-fire-interval*)
         )
        (else (+! *doppel-fire-rotation-timer* -1))
        )
      )
    )
  (none)
  )

(defun doppel-timer-update ()
  (none)
  )

(defun doppel-activate ()
  (cond
    (*doppel-active*
     (format #t "[DOPPEL] already active~%")
     )
    (else
     (format #t "[DOPPEL] orbital defense activated~%")
     (set! *doppel-active*       #t)
     (set! *doppel-orb-angle-0*  0.0)
     (set! *doppel-orb-angle-1*  21845.333)
     (set! *doppel-orb-angle-2*  43690.667)
     (set! *doppel-fire-rotation-timer* 0)
     (set! *doppel-fire-next-orb*       0)
     )
    )
  (none)
  )

(defun djak-modifier-check-input ()
  (when (and (cpad-hold? (-> *target* control cpad number) l1)
             (cpad-pressed? (-> *target* control cpad number) x))
    (set! *djak-blink-modifier* (not *djak-blink-modifier*))
    (format #t "[MOD] blink=~A~%" *djak-blink-modifier*)
    (cpad-clear! (-> *target* control cpad number) x)
    )
  (when (and (cpad-hold? (-> *target* control cpad number) l1)
             (cpad-pressed? (-> *target* control cpad number) circle))
    (set! *djak-doppel-modifier* (not *djak-doppel-modifier*))
    (when (and (not *djak-doppel-modifier*) *doppel-active*)
      (doppel-deactivate)
      )
    (format #t "[MOD] doppel=~A~%" *djak-doppel-modifier*)
    (cpad-clear! (-> *target* control cpad number) circle)
    )
  (none)
  )