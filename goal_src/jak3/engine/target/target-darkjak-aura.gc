(in-package goal)

;; name: target-darkjak-aura.gc
;; Dark Jak particle aura - spawns dark eco particles off Jak's body joints
;; while Dark Jak transformation is active
;; Part 173  - vanilla dark eco hotdot (subtle crackling)
;; Part 5220 - custom dark violet glow (reserved for future use)
;; Part 5221 - custom radial-gradient (fluid dark eco clinging - normal)
;; Part 5222 - custom radial-gradient (fluid dark eco clinging - GDJ scaled up)

(defpart 5220
  :init-specs ((:texture (glow level-default-sprite))
    (:num 2.0)
    (:scale-x (meters 0.3) (meters 0.2))
    (:scale-y :copy scale-x)
    (:r 180.0)
    (:g 0.0)
    (:b 255.0)
    (:a 80.0 40.0)
    (:vel-y (meters 0.04) (meters 0.02))
    (:scalevel-x (meters -0.001))
    (:scalevel-y :copy scalevel-x)
    (:fade-a -1.5)
    (:friction 0.98)
    (:timer (seconds 0.3))
    (:flags (sp-cpuinfo-flag-2 sp-cpuinfo-flag-3))
    (:conerot-x (degrees 0) (degrees 3600))
    (:conerot-y (degrees 0) (degrees 3600))
    )
  )

(defpart 5221
  :init-specs ((:texture (radial-gradient level-default-sprite))
    (:num 2.0)
    (:scale-x (meters 0.6) (meters 0.2))
    (:scale-y :copy scale-x)
    (:r 20.0)
    (:g 0.0)
    (:b 100.0)
    (:a 80.0 40.0)
    (:vel-y (meters 0.005) (meters 0.003))
    (:scalevel-x (meters -0.002))
    (:scalevel-y :copy scalevel-x)
    (:fade-r -0.1)
    (:fade-g 0.0)
    (:fade-b -0.3)
    (:fade-a -0.4)
    (:friction 0.96)
    (:timer (seconds 0.8))
    (:flags (sp-cpuinfo-flag-0 sp-cpuinfo-flag-3))
    (:conerot-x (degrees 0) (degrees 3600))
    (:conerot-y (degrees 0) (degrees 3600))
    (:conerot-radius (meters 0.1))
    )
  )

(defpart 5222
  :init-specs ((:texture (radial-gradient level-default-sprite))
    (:num 2.0)
    (:scale-x (meters 1.4) (meters 0.4))
    (:scale-y :copy scale-x)
    (:r 20.0)
    (:g 0.0)
    (:b 100.0)
    (:a 80.0 40.0)
    (:vel-y (meters 0.008) (meters 0.004))
    (:scalevel-x (meters -0.003))
    (:scalevel-y :copy scalevel-x)
    (:fade-r -0.1)
    (:fade-g 0.0)
    (:fade-b -0.3)
    (:fade-a -0.4)
    (:friction 0.96)
    (:timer (seconds 0.8))
    (:flags (sp-cpuinfo-flag-0 sp-cpuinfo-flag-3))
    (:conerot-x (degrees 0) (degrees 3600))
    (:conerot-y (degrees 0) (degrees 3600))
    (:conerot-radius (meters 0.2))
    )
  )
(defun darkjak-aura-tick ()
  "Spawn dark eco particles on random Jak body joints while Dark Jak is active"
  (when (and *target*
             (focus-test? *target* dark)
             (not (focus-test? *target* in-head))
             (not (logtest? (-> *target* draw status) (draw-control-status no-draw no-draw-temp)))
             )
    (let* ((is-giant (logtest? (-> *target* darkjak stage) (darkjak-stage giant)))
           (aura-part (if is-giant 5222 5221))
           (spawn-count (if is-giant 4 6))
           )
      (dotimes (i spawn-count)
        (let ((joint (rand-vu-int-range 3 (+ (-> *target* node-list length) -1))))
          (vector-copy!
            (-> *launch-matrix* trans)
            (vector<-cspace! (new 'stack-no-clear 'vector) (-> *target* node-list data joint))
            )
          (sp-launch-particles-var
            *sp-particle-system-2d*
            (-> *part-id-table* 173)
            *launch-matrix*
            (the-as sparticle-launch-state #f)
            (the-as sparticle-launch-control #f)
            1.0
            )
          (sp-launch-particles-var
            *sp-particle-system-2d*
            (-> *part-id-table* aura-part)
            *launch-matrix*
            (the-as sparticle-launch-state #f)
            (the-as sparticle-launch-control #f)
            1.0
            )
          )
        )
      )
    )
  0
  (none)
  )